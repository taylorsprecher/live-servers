; AirCore demo program — Airlet "DemoAirlet"
; Built from the spec's own examples (BlackBerry LAN.docx):
;   * the execution-trace example:  x = 5; if x > 3: y = x + 2
;   * the diagnostics() example:    LOAD_NAME diagnostics / CALL_FUNCTION 0
; Extended with CHECK_POLICY so AirShield decides two actions live:
;   "diagnostics" -> allowed by policy, "network" -> denied by policy.

        LOAD_CONST 5
        STORE_FAST x
        LOAD_FAST x
        LOAD_CONST 3
        COMPARE_GT
        JUMP_IF_FALSE skip
        LOAD_FAST x
        LOAD_CONST 2
        BINARY_ADD
        STORE_FAST y
skip:
        LOAD_CONST "network"
        CHECK_POLICY
        STORE_FAST net_allowed
        LOAD_CONST "diagnostics"
        CHECK_POLICY
        STORE_FAST diag_allowed
        LOAD_NAME diagnostics
        CALL_FUNCTION 0
        STORE_FAST diag
        LOAD_CONST "y"
        LOAD_FAST y
        LOAD_CONST "diag_allowed"
        LOAD_FAST diag_allowed
        LOAD_CONST "net_allowed"
        LOAD_FAST net_allowed
        LOAD_CONST "diag"
        LOAD_FAST diag
        BUILD_MAP 4
        RETURN_VALUE
