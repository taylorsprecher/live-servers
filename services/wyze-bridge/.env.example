# Copy to ".env" on the deployment host and fill in there.
# PLACEHOLDERS ONLY in this file — never put real credentials in git/chat.

# Wyze API credentials for docker-wyze-bridge (create in the Wyze
# developer portal; the account email/password go in secrets/ instead).
API_ID=your-wyze-api-id
API_KEY=your-wyze-api-key

# Hostname/IP other LAN devices use to reach the bridge host.
# The status service uses container DNS inside the compose stack;
# this is for your own bookmarks/players.
BRIDGE_LAN_HOST=192.168.0.X

# Archive tier state (booleans only — no secrets here).
# deploy/preflight.sh sets ARCHIVE_CONFIGURED=true once the AWS secrets
# exist; deploy/deploy.sh --archive sets ARCHIVE_ENABLED=true. The status
# service reads these so its archive view stays honest.
ARCHIVE_CONFIGURED=false
ARCHIVE_ENABLED=false
